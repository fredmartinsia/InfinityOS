{
  "permissions": {
    "defaultMode": "auto"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 {{HOME}}/.claude/scripts/vault_guard.py"
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 {{HOME}}/.claude/scripts/no_emdash_guard.py"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 {{HOME}}/.claude/scripts/vault_rag.py"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 {{HOME}}/.claude/scripts/mcp_lean.py autodetect"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 {{HOME}}/.claude/scripts/vault_writer.py"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh {{HOME}}/.claude/scripts/claude_mem_pid_guard.sh"
          },
          {
            "type": "command",
            "command": "python3 {{HOME}}/.claude/scripts/instincts.py inject --hook"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 {{HOME}}/.claude/scripts/mcp_lean.py clean"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "python3 {{HOME}}/.claude/scripts/statusline.py",
    "padding": 1,
    "refreshInterval": 30
  },
  "env": {
    "INFINITY_VAULT_PATH": "{{VAULT_PATH}}"
  },
  "language": "{{LANGUAGE}}",
  "skipDangerousModePermissionPrompt": true,
  "skipAutoPermissionPrompt": true
}
