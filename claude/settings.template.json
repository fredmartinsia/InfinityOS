{
  "permissions": {
    "defaultMode": "auto"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/scripts/vault_guard.py"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/scripts/vault_rag.py"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/scripts/vault_writer.py"
          }
        ]
      }
    ]
  },
  "env": {
    "CLAUDE_VAULT_PATH": "{{VAULT_PATH}}"
  },
  "enabledPlugins": {
    "claude-mem@thedotmack": true,
    "ui-ux-pro-max@nextlevelbuilder": true
  },
  "extraKnownMarketplaces": {
    "thedotmack": {
      "source": {
        "source": "github",
        "repo": "thedotmack/claude-mem"
      }
    },
    "nextlevelbuilder": {
      "source": {
        "source": "github",
        "repo": "nextlevelbuilder/ui-ux-pro-max-skill"
      }
    }
  },
  "language": "{{LANGUAGE}}",
  "skipDangerousModePermissionPrompt": true,
  "skipAutoPermissionPrompt": true
}
